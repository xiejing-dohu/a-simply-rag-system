# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=rag_system

# Redis
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
DOCUMENT_WORKER_CONCURRENCY=2

# MinIO
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# Authentication placeholders
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI-compatible model service
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_API_BASE=https://example.com/compatible-mode/v1
DEFAULT_MODEL=qwen-plus-latest
EMBEDDING_MODEL=text-embedding-v4

# Optional model discovery filters
# AVAILABLE_MODELS=qwen-plus-latest,qwen-max-latest
# MODEL_PROVIDER=DashScope

# Optional reranker: none or dashscope
RERANK_PROVIDER=none
RERANK_MODEL=qwen3-rerank
# RERANK_API_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# RERANK_API_KEY=replace-with-your-rerank-api-key
